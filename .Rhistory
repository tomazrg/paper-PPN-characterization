summary(aphelenchus_glmer_binomial)
aphelenchus_coef = coef(summary(aphelenchus_glmer_binomial))
plogis(aphelenchus_coef$cond)
0.03748/sqrt(21) # City variance (standard error)
summary(aphelenchoides_glmer_binomial)
aphelenchoides_coef = coef(summary(aphelenchoides_glmer_binomial))
plogis(aphelenchoides_coef$cond)
0.03748/sqrt(21) # City variance (standard error)
