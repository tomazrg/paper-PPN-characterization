rotylenchulus_glmer_city = glmmTMB(quantity ~ (1|region:city) , data = rotylenchulus,
family = poisson(link = "log"))
rotylenchulus_samples = glmmTMB(quantity ~ (1|region:city:samples) , data = rotylenchulus,
family = poisson(link = "log"))
anova(rotylenchulus_glmer_full,rotylenchulus_glmer_city, test = "LRT")
anova(rotylenchulus_glmer_full, rotylenchulus_samples, test = "LRT")
#Criconematidae
criconematidae_glmer_full = glmmTMB(quantity ~ (1|region:city) +  (1|region:city:samples), data = criconematidae,
family = poisson(link = "log"))
criconematidae_glmer_city = glmmTMB(quantity ~ (1|region:city) , data = criconematidae,
family = poisson(link = "log"))
criconematidae_samples = glmmTMB(quantity ~ (1|region:city:samples) , data = criconematidae,
family = poisson(link = "log"))
anova(criconematidae_glmer_full,criconematidae_glmer_city, test = "LRT")
anova(criconematidae_glmer_full, criconematidae_samples, test = "LRT")
summary(aphelenchus_glmer)
0.1198/sqrt(21) # City variance (standard error)
((0.3461/sqrt(21)) * 1.96)#P-value
0.6596/sqrt(238) #Field variance (standard error)
((0.8122/sqrt(238)) * 1.96)#P-value
summary(aphelenchoides_glmer)
0.2836/sqrt(21) # City variance (standard error)
((0.5325/sqrt(21)) * 1.96)#P-value
0.3967/sqrt(188) #Field variance (standard error)
((0.6299/sqrt(188)) * 1.96)#P-value
summary(pratylenchus_glmer)
0.1165/sqrt(20) # City variance (standard error)
((0.3414/sqrt(20)) * 1.96)#P-value
0.9126/sqrt(197) #Field variance (standard error)
((0.9553 /sqrt(197)) * 1.96)#P-value
summary(helicotylenchus_glmer)
0.3894/sqrt(22) # City variance (standard error)
((0.624 /sqrt(22)) * 1.96)#P-value
1.0797/sqrt(264) #Field variance (standard error)
((1.039/sqrt(264)) * 1.96)#P-value
summary(rotylenchulus_glmer)
6.230e-09/sqrt(4) # City variance (standard error)
((7.893e-05/sqrt(4)) * 1.96)#P-value
