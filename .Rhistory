genus_binomial = rbind(pratylenchus_name_binomial,helicotylenchus_name_binomial,
rotylenchulus_name_binomial,criconematidae_name_binomial,
aphelenchus_name_binomial,aphelenchoides_name_binomial)
all_genus_binomial = cbind(all_genus_binomial,genus_binomial)
select_region_city_binomial = all_genus_binomial %>%
filter(genus %in% c("Helicotylenchus","Pratylenchus","Aphelenchus",
"Aphelenchoides","Rotylenchulus", "Criconematidae")) %>%
filter(grpvar == "region:city")
all_genus_binomial1 <- all_genus_binomial %>% #CORRIGIR O P-VALOR E OBTER PELO MÉTODO DE PSEUDO-VEROSSIMILHANÇA
group_by(genus) %>%
summarise(
n=n(),
mean=mean(condval),
sd=sd(condval)
) %>%
mutate( se=sd/sqrt(n))  %>%
mutate( ic=se * qt((1-0.05)/2 + .5, n-1),
lower = (mean - 1.96*se),
upper = (mean + 1.96*se),
p_value = ((sd/sqrt(n)) * 1.96))
summary(pratylenchus_glmer_binomial)
confint(helicotylenchus_glmer_binomial)
incidence = all_genus_binomial1 |>
#filter(!genus == "Pratylenchus") |>
ggplot(aes(reorder(genus,+mean), y = mean))+
geom_bar(stat = "identity", position = "dodge", fill = "darkgreen")+
theme_minimal()+
theme(axis.text.x = element_text(angle = 45, hjust = 1,vjust = 1.2, size = 14),
text = element_text(size = 16))+
labs(x = "Grupos morfológicos",
y = "Efeito aleatório",
title = "Municípios/Regiões")
population = gsheet::gsheet2tbl("https://docs.google.com/spreadsheets/d/1YSK-g-vGZLTVZBPNpH0mo8oQZ6FkMH8xwdb-bs-ee2s/edit?usp=sharing")
head(population)
#Total abundance in falcon tube
population$quantity = 6.66*population$quantity
population$quantity =as.integer(population$quantity)
population$quantity =as.numeric(population$quantity)
population[population$soil== "Chernossolo",c("soil_corrigido")] <- 1
population[population$soil== "Argissolo",c("soil_corrigido")] <- 2
population[population$soil== "Neossolo",c("soil_corrigido")] <- 3
population[population$soil== "Gleissolo",c("soil_corrigido")] <- 4
population[population$soil== "Cambissolo",c("soil_corrigido")] <- 5
population[population$soil== "Latossolo",c("soil_corrigido")] <- 6
aphelenchus = population %>%
filter(quantity >0) %>%
filter(genus == "Aphelenchus") %>%
#filter(!soil %in% c("Neossolo","Chernossolo","Gleissolo")) %>%
filter(soil_corrigido %in% c("2","5","6")) %>%
filter(region %in% c("South","Southwest","Center","East")) %>%
group_by(samples,region,city) %>%
summarise(
quantity = sum(quantity)
)
aphelenchus_glmer = glmmTMB(quantity ~ (1|region:city) +  (1|region:city:samples), data = aphelenchus,
family = poisson(link = "log"))
summary(aphelenchus_glmer)
check_singularity(aphelenchus_glmer)
check_overdispersion(aphelenchus_glmer)
model_performance(aphelenchus_glmer)
check_model(aphelenchus_glmer)
#ggsave("model_check/check_aphelenchus_abundance_glmm.png", bg = "white", dpi = 600, width = 12)
aphelenchus_res <- simulateResiduals(aphelenchus_glmer)
plot(aphelenchus_res)
#----------------------------------------------------------
aphelenchoides = population %>%
filter(genus == "Aphelenchoides")%>%
filter(quantity >0) %>%
#filter(!soil %in% c("Neossolo","Chernossolo","Gleissolo")) %>%
filter(soil_corrigido %in% c("2","5","6"))  %>%
filter(region %in% c("South","Southwest","Center","East")) %>%
group_by(samples,region,city) %>%
summarise(
quantity = sum(quantity)
)
aphelenchoides_glmer = glmmTMB(quantity ~ (1|region:city) +  (1|region:city:samples), data = aphelenchoides,
family = poisson(link = "log"))
summary(aphelenchoides_glmer)
check_singularity(aphelenchoides_glmer)
check_overdispersion(aphelenchoides_glmer)
model_performance(aphelenchoides_glmer)
check_model(aphelenchoides_glmer)
#ggsave("model_check/check_aphelenchoides_abundance_glmm.png", bg = "white", dpi = 600, width = 12)
aphelenchoides_res <- simulateResiduals(aphelenchoides_glmer)
plot(aphelenchoides_res)
