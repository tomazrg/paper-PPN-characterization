pratylenchus_groups = ranef(pratylenchus_glmer)
pratylenchus_groups = as.data.frame(pratylenchus_groups)
helicotylenchus_groups = ranef(helicotylenchus_glmer)
helicotylenchus_groups = as.data.frame(helicotylenchus_groups)
rotylenchulus_groups = ranef(rotylenchulus_glmer)
rotylenchulus_groups = as.data.frame(rotylenchulus_groups)
criconematidae_groups = ranef(criconematidae_glmer)
criconematidae_groups = as.data.frame(criconematidae_groups)
aphelenchus_groups = ranef(aphelenchus_glmer)
aphelenchus_groups = as.data.frame(aphelenchus_groups)
aphelenchoides_groups = ranef(aphelenchoides_glmer)
aphelenchoides_groups = as.data.frame(aphelenchoides_groups)
all_genus = rbind(pratylenchus_groups,helicotylenchus_groups,rotylenchulus_groups,
criconematidae_groups,aphelenchus_groups,aphelenchoides_groups)
nrow(aphelenchoides_groups)
pratylenchus_name = replicate(217,"Pratylenchus")
pratylenchus_name = as.data.frame(pratylenchus_name)
colnames(pratylenchus_name)[1] = "genus"
helicotylenchus_name = replicate(286,"Helicotylenchus")
helicotylenchus_name = as.data.frame(helicotylenchus_name)
colnames(helicotylenchus_name)[1] = "genus"
rotylenchulus_name = replicate(22,"Rotylenchulus")
rotylenchulus_name = as.data.frame(rotylenchulus_name)
colnames(rotylenchulus_name)[1] = "genus"
criconematidae_name = replicate(76,"Criconematidae")
criconematidae_name = as.data.frame(criconematidae_name)
colnames(criconematidae_name)[1] = "genus"
aphelenchus_name = replicate(259,"Aphelenchus")
aphelenchus_name = as.data.frame(aphelenchus_name)
colnames(aphelenchus_name)[1] = "genus"
aphelenchoides_name = replicate(209,"Aphelenchoides")
aphelenchoides_name = as.data.frame(aphelenchoides_name)
colnames(aphelenchoides_name)[1] = "genus"
genus = rbind(pratylenchus_name,helicotylenchus_name,rotylenchulus_name,
criconematidae_name,aphelenchus_name,aphelenchoides_name)
all_genus = cbind(all_genus,genus)
select_region_city_samples = all_genus %>%
filter(genus %in% c("Helicotylenchus","Pratylenchus","Aphelenchus",
"Aphelenchoides","Rotylenchulus", "Criconematidae")) %>%
filter(grpvar == "region:city:samples")
select_region_city = all_genus %>%
filter(genus %in% c("Helicotylenchus","Pratylenchus","Aphelenchus",
"Aphelenchoides","Rotylenchulus", "Criconematidae")) %>%
filter(grpvar == "region:city")
colnames(select_region_city_samples) = c("group","term","grp","mean","sd","genus")
colnames(select_region_city) = c("group","term","grp","mean","sd","genus")
all_genus1 <- all_genus %>%
group_by(grpvar,genus) %>%
summarise(
n=n(),
mean=mean(condval),
sd=sd(condval)
) %>%
mutate( se=sd/sqrt(n))  %>%
mutate( ic=se * qt((1-0.05)/2 + .5, n-1),
lower = (mean - 1.96*se),
upper = (mean + 1.96*se),
p_value = ((sd/sqrt(n)) * 1.96))
all_genus1 %>%
filter(genus %in% c("Helicotylenchus","Pratylenchus","Aphelenchus",
"Aphelenchoides","Rotylenchulus", "Criconematidae")) %>%
# filter(grpvar == "soil:city:altitute") %>%
ggplot(aes(genus,mean))+
geom_bar(stat = "identity", position = "dodge")+
facet_wrap(~grpvar)+
theme(axis.text.x = element_text(angle = 45, hjust = 1))
